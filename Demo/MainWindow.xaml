<Window
	x:Class="Demo.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cs="clr-namespace:WPF.CornerSmoothing;assembly=WPF.CornerSmoothing"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="MainWindow"
	d:Background="White"
	SizeToContent="WidthAndHeight"
	mc:Ignorable="d">

	<Window.Resources>
		<LinearGradientBrush x:Key="Background" SpreadMethod="Pad" StartPoint="0,1" EndPoint="1,0">
			<GradientStop Offset="1" Color="#FFFF91EC" />
			<GradientStop Color="#FFF7F0CA" />
		</LinearGradientBrush>
		<Brush x:Key="BorderBrush">#4C000000</Brush>
	</Window.Resources>

	<StackPanel Margin="20">
		<WrapPanel Margin="0,0,0,30" Orientation="Horizontal">
			<Border
				Width="200"
				Height="200"
				Padding="{Binding ElementName=Padding, Path=Value}"
				Background="{StaticResource Background}"
				BorderBrush="{StaticResource BorderBrush}"
				BorderThickness="{Binding ElementName=BorderThickness, Path=Value}"
				CornerRadius="{Binding ElementName=CornerRadius, Path=Value}">
				<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">Border</TextBlock>
			</Border>

			<cs:SmoothBorder
				Width="200"
				Height="200"
				Margin="5,0,0,0"
				Padding="{Binding ElementName=Padding, Path=Value}"
				Background="{StaticResource Background}"
				BorderBrush="{StaticResource BorderBrush}"
				BorderThickness="{Binding ElementName=BorderThickness, Path=Value}"
				ClipContent="{Binding ElementName=ClipContent, Path=IsChecked}"
				CornerRadius="{Binding ElementName=CornerRadius, Path=Value}"
				CornerSmoothing="{Binding ElementName=CornerSmoothing, Path=Value}">
				<Grid>
					<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">SmoothBorder</TextBlock>
				</Grid>
			</cs:SmoothBorder>

			<cs:SmoothBorder
				Width="200"
				Height="200"
				Margin="5,0,0,0"
				Padding="{Binding ElementName=Padding, Path=Value}"
				Background="{StaticResource Background}"
				BorderBrush="{StaticResource BorderBrush}"
				BorderThickness="{Binding ElementName=BorderThickness, Path=Value}"
				ClipContent="{Binding ElementName=ClipContent, Path=IsChecked}"
				CornerRadius="{Binding ElementName=CornerRadius, Path=Value}"
				CornerSmoothing="{Binding ElementName=CornerSmoothing, Path=Value}">
				<Grid Background="#498EC4FA">
					<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">SmoothBorder with content</TextBlock>
				</Grid>
			</cs:SmoothBorder>
		</WrapPanel>

		<CheckBox x:Name="ClipContent" IsChecked="False">ClipContent</CheckBox>

		<TextBlock>
			CornerSmoothing:<Run Text="{Binding ElementName=CornerSmoothing, Path=Value}" /></TextBlock>
		<Slider
			x:Name="CornerSmoothing"
			Maximum="1"
			Minimum="0"
			Value="1" />

		<TextBlock>
			CornerRadius:<Run Text="{Binding ElementName=CornerRadius, Path=Value}" /></TextBlock>
		<Slider
			x:Name="CornerRadius"
			Interval="1"
			Maximum="100"
			Minimum="0"
			Value="40" />

		<TextBlock>
			Padding:<Run Text="{Binding ElementName=Padding, Path=Value}" /></TextBlock>
		<Slider
			x:Name="Padding"
			Interval="1"
			IsSelectionRangeEnabled="True"
			IsSnapToTickEnabled="True"
			Maximum="100"
			Minimum="0"
			Value="0" />

		<TextBlock>
			BorderThickness:<Run Text="{Binding ElementName=BorderThickness, Path=Value}" /></TextBlock>
		<Slider
			x:Name="BorderThickness"
			Interval="1"
			Maximum="100"
			Minimum="0"
			Value="10" />
	</StackPanel>
</Window>